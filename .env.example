# PlaceMatch environment configuration
# Copy this file to `.env` and fill in real values before a live (non-mock) run.
# NEVER commit the real `.env` file. It is already listed in .gitignore.

# ---------------------------------------------------------------------------
# LLM provider selection
# ---------------------------------------------------------------------------
# "llmod" is the real course-provided provider. Keep MOCK_LLM=true for all
# normal development and testing -- this makes zero paid LLM calls.
LLM_PROVIDER=llmod
MOCK_LLM=true

# ---------------------------------------------------------------------------
# LLMod.ai course provider credentials and endpoint configuration
# ---------------------------------------------------------------------------
# Fill these in only when you have a real LLMod.ai key from the course.
# Re-register at LLMod.ai with the course-requested new email BEFORE
# requesting your project API key. See README "Course Submission Checklist".
LLMOD_API_KEY=
LLMOD_BASE_URL=https://api.llmod.ai
LLMOD_CHAT_COMPLETIONS_PATH=/v1/chat/completions
LLMOD_MODEL=
LLMOD_AUTH_HEADER=Authorization
LLMOD_AUTH_SCHEME=Bearer

# ---------------------------------------------------------------------------
# Budget controls (course budget is $13 per group -- see README)
# ---------------------------------------------------------------------------
MAX_PROJECT_BUDGET_USD=13
MAX_LLM_CALLS_PER_REQUEST=4
LLM_MAX_INPUT_TOKENS=4000
LLM_MAX_OUTPUT_TOKENS=1500
# Pricing is provider-dependent and NOT hard-coded; set these to the real
# LLMod.ai pricing once known. Values below are placeholders for local
# conservative cost estimation only and are clearly marked "estimated" in
# the usage ledger, never presented as the official LLMod balance.
LLM_INPUT_COST_PER_1M=0
LLM_OUTPUT_COST_PER_1M=0

# ---------------------------------------------------------------------------
# Networking / performance
# ---------------------------------------------------------------------------
HTTP_TIMEOUT_SECONDS=10
# Hard backend budget for the complete agent run. It may be lowered but cannot
# exceed 285 seconds, reserving 15 seconds for API/UI overhead under the
# externally observed 300-second requirement.
AGENT_EXECUTION_TIMEOUT_SECONDS=285
# Stop unfinished research with this much backend time left, then score and
# render recommendations from the evidence already collected.
RECOMMENDATION_RESERVE_SECONDS=60
# Maximum wall-clock time for one tool/candidate invocation, including its
# internal retries and provider failover. The shared 225-second research
# cutoff can still stop it sooner.
TOOL_EXECUTION_TIMEOUT_SECONDS=50
# Independent tool/candidate jobs run concurrently up to this application cap.
# Provider-specific controls still apply (Nominatim serial, Overpass max 2).
MAX_CONCURRENT_TOOL_REQUESTS=10
CACHE_TTL_HOURS=168
# If deployment uses a proxy/load balancer, declare its actual request/read
# timeout here as a startup-validated safety check, and configure the same
# value in the platform itself. It must exceed the 285-second backend limit.
# UPSTREAM_REQUEST_TIMEOUT_SECONDS=290

# ---------------------------------------------------------------------------
# Storage / server
# ---------------------------------------------------------------------------
SQLITE_PATH=./data/placematch.db
APP_PORT=8000

# ---------------------------------------------------------------------------
# Request limits
# ---------------------------------------------------------------------------
MAX_PROMPT_LENGTH=4000
# Stage-1 bulk LLM recall size (candidate-discovery funnel) -- still a single LLM call.
MAX_BULK_CANDIDATES=30
# Stage-3 finalist count that gets the full tool suite + scoring. Validated empirically
# against real Overpass/Nominatim latency (see docs/tool_implementation_master_plan.md);
# raising this significantly increases Overpass call volume against its global 2-concurrent cap.
MAX_FINALISTS=8
MAX_FINAL_RECOMMENDATIONS=8
MAX_RESEARCH_ITERATIONS=1
MAX_JSON_REPAIR_ATTEMPTS=1

# ---------------------------------------------------------------------------
# Live/optional test gating -- DO NOT set to 1 unless you intend to spend
# real LLMod.ai course credit.
# ---------------------------------------------------------------------------
RUN_LIVE_TESTS=0
